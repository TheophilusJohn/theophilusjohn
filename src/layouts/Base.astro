---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Toggles from '../components/Toggles.astro';

interface Props { title: string; description?: string; }
// Third person, and search terms rather than the hero's voice — this
// is what shows up in results and link previews, not on the page.
const { title, description = 'Theophilus John builds distributed systems and runs production infrastructure. Consensus, replication, and browser-native inference.' } = Astro.props;
// One page (§4.6), so these are ranges on `/`, not routes. Absolute with
// a hash so they also work from the standalone project pages.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/theo-john-resume.pdf', label: 'Resume' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  <!-- Display face only. The mono carries metadata that can swap in late. §5 -->
  <link
    rel="preload"
    href="/fonts/archivo-var-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- Applied before first paint so neither toggle flashes. §5 -->
  <script is:inline>
    (function () {
      var r = document.documentElement;
      try {
        if (localStorage.getItem('tj:contrast') === 'high') r.dataset.contrast = 'high';
        // Three states (§5). A stored value wins in both directions; the OS
        // is consulted only for the third, `auto`, which is the absence of
        // a key. Anything else stored is treated as absent.
        var m = localStorage.getItem('tj:motion');
        if (m === 'off' || m === 'on') r.dataset.motion = m;
        else if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.dataset.motion = 'off';
      } catch (e) {}
    })();
  </script>

  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="wrap site-head">
    <a href="/" class="wordmark">theophilusjohn.com</a>
    <nav aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <Toggles />
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="wrap site-foot">
    <span class="meta">Houston, TX</span>
    <span class="meta">
      <a href="https://github.com/TheophilusJohn">GitHub</a> ·
      <a href="mailto:theo@theophilusjohn.com">Email</a>
    </span>
  </footer>

  <style>
    .site-head, .site-foot {
      display: flex; justify-content: space-between;
      align-items: baseline; gap: var(--s-4);
      padding-block: var(--s-6);
    }

    /* The head needs 384px of content to sit on one line (wordmark 151
       + nav 217 + gap). Below that it wrapped nowhere and just pushed
       the document into horizontal scroll. Let it wrap instead: the
       nav drops under the wordmark on its own, no breakpoint needed —
       384px of content is available at 768 and up, and isn't at 390.
       nav wraps too, as a floor for viewports narrower than 360. */
    .site-head { flex-wrap: wrap; }

    .site-foot { border-top: 1px solid var(--rule); margin-top: var(--s-24); }
    .wordmark { font-family: var(--font-mono); font-size: var(--t-sm); text-decoration: none; }
    nav { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-4); }
    nav a {
      font-family: var(--font-mono); font-size: var(--t-meta);
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--dim); text-decoration: none;
    }
    nav a:hover { color: var(--leader); }
  </style>
</body>
</html>
