---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Toggles from '../components/Toggles.astro';
import Entry from '../components/Entry.astro';

// `entry` is only true on the page the world can actually mount on (§33).
// The mode attribute is set site-wide because the header's way back into
// the world is, but a curtain on a page with no world behind it would be a
// load that never finishes.
interface Props { title: string; description?: string; entry?: boolean; }
// Third person, and search terms rather than the hero's voice — this
// is what shows up in results and link previews, not on the page.
const { title, description = 'Theophilus John builds distributed systems and runs production infrastructure. Consensus, replication, and browser-native inference.', entry = false } = Astro.props;
// One page (§4.6), so these are ranges on `/`, not routes. Absolute with
// a hash so they also work from the standalone project pages.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/theo-john-resume.pdf', label: 'Resume' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  <!-- Display face only. The mono carries metadata that can swap in late. §5 -->
  <link
    rel="preload"
    href="/fonts/archivo-var-latin.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <!-- Applied before first paint so neither toggle flashes. §5 -->
  <script is:inline>
    (function () {
      var r = document.documentElement;
      try {
        if (localStorage.getItem('tj:contrast') === 'high') r.dataset.contrast = 'high';
        // Three states (§5). A stored value wins in both directions; the OS
        // is consulted only for the third, `auto`, which is the absence of
        // a key. Anything else stored is treated as absent.
        var m = localStorage.getItem('tj:motion');
        if (m === 'off' || m === 'on') r.dataset.motion = m;
        else if (matchMedia('(prefers-reduced-motion: reduce)').matches) r.dataset.motion = 'off';
      } catch (e) {}

      /* ── The mode, decided before paint (§33 / SPEC §0.1) ───────────
         The world is the site now, so this is what `/` *is* and it has to
         be answered in the same frame the browser paints. Two halves:

         The hard capability gate — a GPU, a wide enough viewport, motion
         on — is not a preference and nothing overrides it. `?world` moves
         memory out of the way, never this: a reader who asked for reduced
         motion gets the document whatever any URL says (§0.6), and a
         browser with no WebGPU cannot be talked into one.

         Then precedence, most explicit first:
             ?doc  >  ?world  >  stored tj:mode  >  capability
         A URL is obeyed and never *written*, because a link someone sent
         you is not a preference. The key is written only by the two
         controls that are a reader's own act — the way out of the world
         below, and the way back in from the header — which is the same
         three-state shape as tj:motion: absent means "decide", not "no".

         `navigator.gpu` here is presence, not an adapter: requesting one
         is async and there is no async before first paint. world.ts asks
         the honest question a moment later and takes the curtain down if
         the answer is no. That gap is why nothing below is destructive —
         the document is painted, in the DOM, and one attribute away. */
      var able =
        !!navigator.gpu && innerWidth >= 1024 && r.dataset.motion !== 'off';
      var mode = 'doc';
      try {
        var q = new URLSearchParams(location.search);
        var pick = q.has('doc') ? 'doc' : q.has('world') ? 'world' : localStorage.getItem('tj:mode');
        mode = pick === 'doc' ? 'doc' : able ? 'world' : 'doc';
      } catch (e) {
        mode = able ? 'world' : 'doc';
      }
      r.dataset.mode = mode;
      if (mode !== 'world') return;

      /* ── The way out, from the first frame ──────────────────────────
         Not in the bundle, because "reachable on the first frame" is a
         promise about a load that has not got a bundle yet. Delegated off
         the document so it binds before `<body>` has been parsed.

         A navigation rather than a teardown: the world holds a GPU device,
         three workers, thirty megabytes of geometry and the scroll lock,
         and the document behind it is a finished 55 KiB page on a warm
         cache. `replace`, so the world is never in the back stack — the
         reader who leaves and presses Back goes where they came from, not
         back into the thing they just escaped. */
      function leave() {
        try { localStorage.setItem('tj:mode', 'doc'); } catch (e) {}
        // The address in world mode is the station's own path (§32). The
        // document says the same thing with a fragment, so a reader who
        // leaves mid-writeup lands on that writeup rather than at the top.
        var at = /^\/projects\/([^/]+)\/?$/.exec(location.pathname);
        location.replace('/?doc' + (at ? '#' + at[1] : location.hash));
      }
      window.__leaveWorld = leave;

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest || !t.closest('[data-escape]')) return;
        e.preventDefault();
        leave();
      });

      /* `Esc` reaches the same thing. Once the world has a frame it owns
         the key — an open writeup is what `Esc` closes first (§32), and
         only with nothing open does it leave — so this hands over the
         moment `data-world` appears rather than racing it.

         And it stands down entirely if the world never comes. On the
         adapter-refused path `world.ts` deletes `data-mode`, un-inerts the
         document and deliberately stores nothing; without this condition
         the listener outlives all of that, and one press then navigates to
         `/?doc` and writes `tj:mode = 'doc'` — recording a mode preference
         on a machine that has not expressed one, which is the exact failure
         the rule against storing here was written to prevent (§33's own
         defect, found by §38's audit). */
      addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || e.metaKey || e.ctrlKey || e.altKey) return;
        if (r.dataset.mode !== 'world' || r.dataset.world !== undefined) return;
        leave();
      });

      /* The one thing on the critical path that the bundle cannot start
         early: the loader has to know which chunk to stream before it can
         stream it. Kicked off here so it overlaps the entry chunk's own
         download instead of queueing behind it. */
      try {
        window.__worldManifest = fetch('/world.json').then(function (res) {
          return res.ok ? res.json() : null;
        }).catch(function () { return null; });
      } catch (e) {}
    })();
  </script>

  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="wrap site-head">
    <a href="/" class="wordmark">theophilusjohn.com</a>
    {/* One end of the header, and it moves as one thing (after §38). The
        toggles used to be the last child of the nav, which let them wrap
        onto a line of their own the moment the links filled a row —
        measured at 780px, where they sat under WORK/ABOUT/RESUME/WORLD
        with nothing beside them and read as a second header that had lost
        the first. They are controls rather than links, so nav is the wrong
        parent for them anyway; the banner landmark is still their home, so
        nothing leaves a landmark by this. */}
    <div class="head-end">
      <nav aria-label="Primary">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      {/* §33 — the way back in. §0.1 specifies the way *out* of the world
          and stops there, which on its own is a one-way door: a reader who
          escapes once has `tj:mode` set to doc for good and no way to
          change their mind. A link rather than a button because it is a
          navigation, and `/?world` outranks the stored preference.

          Hidden in the HTML and revealed only by the script at the end of
          the body, which asks for a real adapter first. A control that
          offers something this machine cannot do is worse than no control:
          it would take the reader to a curtain that gives up. */}
        <a href="/?world" data-enter hidden>World</a>
      </nav>
      <Toggles />
    </div>
  </header>

  <main id="main"><slot /></main>

  {entry && <Entry />}

  <footer class="wrap site-foot">
    <span class="meta">Houston, TX</span>
    <span class="meta">
      <a href="https://github.com/TheophilusJohn">GitHub</a>{' · '}
      <a href="mailto:theophilusjohn@gmail.com">Email</a>
    </span>
  </footer>

  <style>
    .site-head, .site-foot {
      display: flex; justify-content: space-between;
      align-items: baseline; gap: var(--s-4);
      padding-block: var(--s-6);
    }

    /* The head needs 384px of content to sit on one line (wordmark 151
       + nav 217 + gap). Below that it wrapped nowhere and just pushed
       the document into horizontal scroll. Let it wrap instead: the
       nav drops under the wordmark on its own, no breakpoint needed —
       384px of content is available at 768 and up, and isn't at 390.
       nav wraps too, as a floor for viewports narrower than 360. */
    .site-head { flex-wrap: wrap; }

    /* The links and the toggles, as one flex item — so the header's own
       wrap moves both of them or neither, and the toggles are always at
       the right edge with the links immediately left of them.

       `nowrap` here and `wrap` on the nav inside it is the whole of the
       fix: the *links* are what may take a second row, and the toggles
       stay beside that block instead of dropping under it. The nav also
       aligns its rows to the right, so a wrapped second row of links ends
       against the toggles rather than leaving a hole between them. */
    .head-end {
      display: flex; align-items: center; flex-wrap: nowrap;
      gap: var(--s-6); min-width: 0;
    }

    .site-foot { border-top: 1px solid var(--rule); margin-top: var(--s-24); }
    .wordmark { font-family: var(--font-mono); font-size: var(--t-sm); text-decoration: none; }
    nav { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: var(--s-4); min-width: 0; }
    nav a {
      font-family: var(--font-mono); font-size: var(--t-meta);
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--dim); text-decoration: none;
    }
    nav a:hover { color: var(--leader); }

    /* Same argument, and the same breakpoint, as the toggles these sit
       next to: once the nav has wrapped to its own line it is being
       tapped. 10px uppercase mono is a 16px-tall box, which is under
       WCAG 2.2's 24px minimum and nothing like the 44px the toggles
       already claim. The ink does not move — the box grows around it,
       and the row lines up with the toggles as a side effect. */
    @media (max-width: 640px) {
      nav a, .wordmark {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
    }
</style>

  <!-- §33. Inline and at the end of the body, so it runs the moment the
       elements above it are parsed and without waiting on a bundle. Two
       jobs, and they are opposite sides of the same decision. -->
  <script is:inline>
    (function () {
      var r = document.documentElement;

      if (r.dataset.mode === 'world') {
        /* The document is painted under an opaque curtain, so it must not
           be reachable: `inert` takes a subtree out of the tab order, out
           of the accessibility tree and out of hit testing in one
           attribute. Deliberately not `visibility: hidden`, which is what
           §21 uses once the world is actually up — hiding it here would
           put the hero's own paint into question for the length of the
           load, and LCP is the one number this step is not allowed to
           move. world.ts clears these if the adapter request fails. */
        var held = document.querySelectorAll('.site-head, main, .site-foot, .skip');
        for (var i = 0; i < held.length; i++) held[i].inert = true;
        return;
      }

      /* Document mode, and the machine might be able to fly. Ask for a
         real adapter before offering: `navigator.gpu` exists in browsers
         that hand out nothing. It is the same question world.ts asks, and
         asking it here is what keeps the control honest. */
      var enter = document.querySelector('[data-enter]');
      if (!enter) return;
      if (!navigator.gpu || innerWidth < 1024 || r.dataset.motion === 'off') return;
      navigator.gpu.requestAdapter().then(function (adapter) {
        if (adapter) enter.hidden = false;
      }).catch(function () {});

      // The link navigates on its own; this is only the memory. Written
      // here rather than read from the URL on the next load, because
      // `?world` is obeyed and never stored (see the head script).
      enter.addEventListener('click', function () {
        try { localStorage.setItem('tj:mode', 'world'); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
