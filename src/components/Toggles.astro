---
// All three controls from §5. State is applied before first paint by the
// inline script in Base.astro, so none of them flashes.
//
// The appearance is first and the other two are at the right edge, because
// contrast and motion are what a struggling reader reaches for and this is
// the third control on a strip §5 says cannot hold a fourth.
---
{/* **Drawn, not typed (§44).** These were ☀ U+2600, ◐ U+25D0 and ≋ U+224B,
    and they were the only three characters on the entire site outside the
    subsetted woff2s — so they fell back to whatever face the OS offered.
    U+2600 is one of the codepoints a platform may serve from a colour emoji
    font, which would put a coloured sun in a monochrome control strip and
    ignore `color` outright: an emoji glyph carries its own palette, so
    neither `--dim` nor the pressed `--leader-ink` would reach it, and the
    one control whose whole job is to show its own state would be the one
    that could not.

    Inline rather than <img>, because that is what lets them be
    `currentColor` — the strip's colour, its hover and its pressed state are
    one declaration on the button and the marks follow. Sized in `em`, so
    the buttons keep the geometry §38 measured and §39 held to the pixel. */}
<div class="toggles">
  <button id="t-theme" type="button" aria-pressed="false" title="Toggle light appearance">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="3.3"/>
      <path d="M13.30 8.00L14.70 8.00"/>
      <path d="M11.75 11.75L12.74 12.74"/>
      <path d="M8.00 13.30L8.00 14.70"/>
      <path d="M4.25 11.75L3.26 12.74"/>
      <path d="M2.70 8.00L1.30 8.00"/>
      <path d="M4.25 4.25L3.26 3.26"/>
      <path d="M8.00 2.70L8.00 1.30"/>
      <path d="M11.75 4.25L12.74 3.26"/>
    </svg>
    <span class="sr-only">Light appearance</span>
  </button>
  <button id="t-contrast" type="button" aria-pressed="false" title="Toggle high contrast">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="6"/>
      {/* The filled half is the mark: a ring alone is a circle, and what
          this control means is one side dark against the other. */}
      <path d="M8 2A6 6 0 0 0 8 14Z" fill="currentColor" stroke="none"/>
    </svg>
    <span class="sr-only">High contrast</span>
  </button>
  <button id="t-motion" type="button" aria-pressed="false" title="Toggle reduced motion">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M2 4.6q1.5-1.8 3 0t3 0 3 0 3 0"/>
      <path d="M2 8q1.5-1.8 3 0t3 0 3 0 3 0"/>
      <path d="M2 11.4q1.5-1.8 3 0t3 0 3 0 3 0"/>
    </svg>
    <span class="sr-only">Reduce motion</span>
  </button>
</div>

<style>
  .toggles { display: flex; gap: var(--s-2); }
  button {
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: 1;
    padding: var(--s-1) var(--s-2);
    cursor: pointer;
  }

  /* 1em square, so the box is the one the glyphs occupied and §38's header
     geometry is untouched. `currentColor` on both, which is the whole
     reason these are inline: the button owns the colour and all three
     states — rest, hover, pressed — reach the mark through it. */
  svg {
    display: block;
    width: 1em; height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  button:hover { color: var(--leader-ink); border-color: var(--leader-ink); }

  /* Painted off the root attribute, which the inline head script sets
     before first paint — not off aria-pressed, which the module below
     can only correct after it. Keying the colour to aria-pressed makes
     a stored toggle flash from inactive to active on every load. */
  :global(html[data-contrast="high"]) #t-contrast,
  :global(html[data-motion="off"]) #t-motion,
  :global(html[data-theme="light"]) #t-theme {
    color: var(--leader-ink);
    border-color: var(--leader-ink);
  }

  /* No chip. The pressed state was built as a --leader fill with --paper on
     it — 7.03:1 for the ink, and the one place #A99BF5 would still appear at
     full strength in the light document. Measured and removed: the fill's own
     boundary against the page is **2.23:1**, under the 3:1 SC 1.4.11 asks of
     the thing that identifies a control's state, and high contrast made it
     worse rather than better (--leader lifts to #C4B8FF there, which is
     1.66:1 on a pale page). The outline above mirrors dark's construction and
     measures 4.54:1, 10.27 in high contrast. What it costs is that the accent
     has no full-strength job left in the light document at all — recorded as
     an open decision in SPEC §8, not papered over here. */

  /* Once the nav has wrapped to its own line these are being tapped,
     not clicked. 26x24 is too small for that — go to a full 44x44
     target. Width-based rather than (pointer: coarse) so it holds on
     a narrow desktop window too, and so it is actually testable. */
  @media (max-width: 640px) {
    button {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  const root = document.documentElement;

  /* Safari in private browsing throws on setItem. A toggle that stops
     responding mid-session is a worse failure than one that forgets the
     choice on reload, so every access is guarded. */
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
    del(k: string) { try { localStorage.removeItem(k); } catch {} },
  };

  /* Contrast: two states. Nothing else feeds this attribute, so dropping
     the key and dropping the attribute mean the same thing. */
  const contrast = document.getElementById('t-contrast');
  if (contrast) {
    contrast.setAttribute('aria-pressed', String(root.dataset.contrast === 'high'));
    contrast.addEventListener('click', () => {
      const on = root.dataset.contrast !== 'high';
      if (on) { root.dataset.contrast = 'high'; store.set('tj:contrast', 'high'); }
      else { delete root.dataset.contrast; store.del('tj:contrast'); }
      contrast.setAttribute('aria-pressed', String(on));
    });
  }

  /* Motion: three states (§5), and only two of them are reachable from
     the button. Un-pressing has to write "on" rather than clear the key —
     clearing it drops back to `auto`, and for the user whose OS asks for
     reduced motion that means the next load silently undoes the choice.
     `auto` is the initial state only, and the OS alone moves it. */
  const motion = document.getElementById('t-motion');
  if (motion) {
    motion.setAttribute('aria-pressed', String(root.dataset.motion === 'off'));
    motion.addEventListener('click', () => {
      const off = root.dataset.motion !== 'off';
      root.dataset.motion = off ? 'off' : 'on';
      store.set('tj:motion', off ? 'off' : 'on');
      motion.setAttribute('aria-pressed', String(off));
    });

    // Still in `auto`: follow the OS if it changes under us.
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      if (store.get('tj:motion')) return;
      if (e.matches) root.dataset.motion = 'off';
      else delete root.dataset.motion;
      motion.setAttribute('aria-pressed', String(e.matches));
    });
  }

  /* Appearance: the same three states and the same reason for writing both
     directions (§39). `auto` is resolved to an explicit attribute by the head
     script, so `light` here is a preference and the absence of the *key* — not
     of the attribute — is what leaves the OS in charge. */
  const theme = document.getElementById('t-theme');
  if (theme) {
    theme.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
    theme.addEventListener('click', () => {
      const light = root.dataset.theme !== 'light';
      root.dataset.theme = light ? 'light' : 'dark';
      store.set('tj:theme', light ? 'light' : 'dark');
      theme.setAttribute('aria-pressed', String(light));
    });

    matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
      if (store.get('tj:theme')) return;
      if (e.matches) root.dataset.theme = 'light';
      else delete root.dataset.theme;
      theme.setAttribute('aria-pressed', String(e.matches));
    });
  }
</script>
