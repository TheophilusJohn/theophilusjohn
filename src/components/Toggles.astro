---
// Both controls from §5. State is applied before first paint by the
// inline script in Base.astro, so there is no flash.
---
<div class="toggles">
  <button id="t-contrast" type="button" aria-pressed="false" title="Toggle high contrast">
    <span aria-hidden="true">◐</span>
    <span class="sr-only">High contrast</span>
  </button>
  <button id="t-motion" type="button" aria-pressed="false" title="Toggle reduced motion">
    <span aria-hidden="true">≋</span>
    <span class="sr-only">Reduce motion</span>
  </button>
</div>

<style>
  .toggles { display: flex; gap: var(--s-2); }
  button {
    background: none;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    line-height: 1;
    padding: var(--s-1) var(--s-2);
    cursor: pointer;
  }
  button:hover { color: var(--leader); border-color: var(--leader); }

  /* Painted off the root attribute, which the inline head script sets
     before first paint — not off aria-pressed, which the module below
     can only correct after it. Keying the colour to aria-pressed makes
     a stored toggle flash from inactive to active on every load. */
  :global(html[data-contrast="high"]) #t-contrast,
  :global(html[data-motion="off"]) #t-motion {
    color: var(--leader);
    border-color: var(--leader);
  }

  /* Once the nav has wrapped to its own line these are being tapped,
     not clicked. 26x24 is too small for that — go to a full 44x44
     target. Width-based rather than (pointer: coarse) so it holds on
     a narrow desktop window too, and so it is actually testable. */
  @media (max-width: 640px) {
    button {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<script>
  const root = document.documentElement;

  /* Safari in private browsing throws on setItem. A toggle that stops
     responding mid-session is a worse failure than one that forgets the
     choice on reload, so every access is guarded. */
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch {} },
    del(k: string) { try { localStorage.removeItem(k); } catch {} },
  };

  /* Contrast: two states. Nothing else feeds this attribute, so dropping
     the key and dropping the attribute mean the same thing. */
  const contrast = document.getElementById('t-contrast');
  if (contrast) {
    contrast.setAttribute('aria-pressed', String(root.dataset.contrast === 'high'));
    contrast.addEventListener('click', () => {
      const on = root.dataset.contrast !== 'high';
      if (on) { root.dataset.contrast = 'high'; store.set('tj:contrast', 'high'); }
      else { delete root.dataset.contrast; store.del('tj:contrast'); }
      contrast.setAttribute('aria-pressed', String(on));
    });
  }

  /* Motion: three states (§5), and only two of them are reachable from
     the button. Un-pressing has to write "on" rather than clear the key —
     clearing it drops back to `auto`, and for the user whose OS asks for
     reduced motion that means the next load silently undoes the choice.
     `auto` is the initial state only, and the OS alone moves it. */
  const motion = document.getElementById('t-motion');
  if (motion) {
    motion.setAttribute('aria-pressed', String(root.dataset.motion === 'off'));
    motion.addEventListener('click', () => {
      const off = root.dataset.motion !== 'off';
      root.dataset.motion = off ? 'off' : 'on';
      store.set('tj:motion', off ? 'off' : 'on');
      motion.setAttribute('aria-pressed', String(off));
    });

    // Still in `auto`: follow the OS if it changes under us.
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      if (store.get('tj:motion')) return;
      if (e.matches) root.dataset.motion = 'off';
      else delete root.dataset.motion;
      motion.setAttribute('aria-pressed', String(e.matches));
    });
  }
</script>
