---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /* 1 on the standalone fallback page, where the project is the document.
     3 on `/`, under the hero h1 and the "Work" h2. */
  level?: 1 | 3;
}
const { project, level = 3 } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const H = `h${level}` as 'h1' | 'h3';

// Split rather than string-replace, so the break is content's decision and
// not a match on whatever words happen to be in the headline.
const words = d.headline.trim().split(/\s+/);
const lines =
  d.headlineBreak === undefined
    ? null
    : [words.slice(0, d.headlineBreak + 1).join(' '), words.slice(d.headlineBreak + 1).join(' ')];
---
{/* §4.3 — three beats. Stacked below 900px and with motion off, where this
    is the plain document order it has always been: headline, lead, writeup.
    Above it, projects.ts sets data-beats and the three layer into one
    pinnable stage that a scrubbed timeline moves through.

    Beat 1 is the headline alone. Beat 2 is the same words as a mono label
    over the summary, the numbers and the links. Beat 3 is the writeup in a
    45ch column.

    §21 took the scrim out. It was a gradient of --void at 92% that darkened
    the scene behind beat 3 so the column kept its contrast bound while the
    rest of the frame ran bright — and there is no scene behind this
    document any more (§0). Over a page that is already --void it was
    invisible ink over its own colour. In world mode the writeup opens in a
    panel that brings its own backing (§0.4). */}
<section
  id={project.id}
  class="wrap project"
  data-path={`/projects/${project.id}`}
  aria-labelledby={`${project.id}-h`}
>
  <div class="top">
    <span class="id">{d.machineId}</span>
    <span class="period">{d.period} · {d.role}</span>
  </div>

  <div class="stage">
    <H id={`${project.id}-h`} class="headline">
      {/* The space before the <br> is load-bearing: without it textContent
          reads "Inferencein the browser", and that string is the section's
          accessible name via aria-labelledby. It collapses when rendered. */}
      {lines ? <>{lines[0]}{' '}<br />{lines[1]}</> : d.headline}
    </H>

    {/* The headline demoted, and the only duplicated text on the page. One
        element cannot cross a face and a size change under a scrub without
        a hard cut somewhere in the middle, which §4.3 forbids — so there
        are two, cross-fading in place, and this one is hidden from
        assistive tech. The h3 above never leaves the DOM or the accessible
        name, it is only transparent from beat 2 on. Never rendered at all
        unless the beats are running. */}
    <p class="label" aria-hidden="true">{d.headline}</p>

    <div class="beat b2">
      <p class="summary">{d.summary}</p>

      {d.metrics.length > 0 && (
        <dl class="stats">
          {d.metrics.map((m) => (
            <div><dt>{m.value}</dt><dd>{m.label}</dd></div>
          ))}
        </dl>
      )}

      <p class="links">
        {d.liveUrl && <a href={d.liveUrl}>Live</a>}
        {d.repoUrl && <a href={d.repoUrl}>Source</a>}
        <span class="stack">{d.stack.join(' · ')}</span>
      </p>
    </div>

    <div class="beat b3">
      <div class="prose"><Content /></div>
    </div>
  </div>

  {/* Progress readout, filled by projects.ts while the section is pinned.
      Empty is its correct resting state, so with no JS — or no pin — it is
      just the rule. */}
  <div class="rail" aria-hidden="true"><span></span></div>
</section>

<style>
  .top { display: flex; justify-content: space-between; gap: var(--s-4); align-items: baseline; padding-top: var(--s-12); }
  .id, .period, .stack {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .id { color: var(--leader); }
  .period, .stack { color: var(--dim); }

  .headline {
    font-size: var(--t-2xl); line-height: 0.94;
    letter-spacing: -0.045em; font-weight: 500;
    margin-top: var(--s-3); font-variation-settings: 'wdth' 120;
  }

  .label, .rail { display: none; }

  .b2 { padding-bottom: var(--s-8); border-bottom: 1px solid var(--rule); }
  .summary { margin-top: var(--s-4); max-width: 48ch; color: var(--muted); font-size: var(--t-lg); }

  .stats { display: flex; flex-wrap: wrap; gap: var(--s-8); margin-top: var(--s-8); }
  .stats dt { font-size: var(--t-xl); color: var(--leader); font-weight: 500; letter-spacing: -0.03em; }
  .stats dd {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim);
  }

  .links { display: flex; gap: var(--s-4); align-items: baseline; margin-top: var(--s-8); flex-wrap: wrap; }
  .links a {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--leader);
  }

  /* The only two links inside a project, and on a phone the only way out
     of it. 30x16 is under WCAG 2.2's 24px minimum and they are not inline
     in a sentence, so the exception does not cover them — the box grows,
     the ink stays put. The row centres rather than sitting on the baseline
     because the links are now taller than the stack line beside them. */
  @media (max-width: 640px) {
    .links { align-items: center; }
    .links a { display: inline-flex; align-items: center; min-height: 44px; }
  }

  .prose { max-width: var(--measure); padding-block: var(--s-8); }
  .prose :global(p) { color: var(--muted); margin-bottom: var(--s-4); }

  /* ── The stage ────────────────────────────────────────────────────────
     Only under data-beats, which projects.ts sets on the sections it is
     about to pin — so this layout and the pin arrive together and a page
     with no JS, motion off, or a viewport too short for a beat never sees
     it. The three beats occupy one screen between them because they are
     layered, not stacked: that is where the room for the world comes
     from. Opacity is the resting state the timeline writes over. */
  @media (min-width: 900px) {
    .project[data-beats] {
      position: relative;
      display: grid;
      grid-template-rows: auto auto;
      align-content: center;
      row-gap: var(--s-12);
      min-height: 100svh;
      padding-block: var(--s-8);
    }
    .project[data-beats] > .top { position: relative; padding-top: 0; }
    /* The beats travel vertically into and out of the handover, and this
       is §4.2's mask doing the same job for them: clip the travel axis
       only, so nothing slides up over the machine ID or down past the
       section, and the horizontal bleed the display headline needs is
       untouched. `visible` degrades to `auto` beside `hidden` or `scroll`
       but not beside `clip`, which is the whole reason this pair works. */
    .project[data-beats] .stage {
      position: relative; display: grid; row-gap: var(--s-8);
      overflow: visible clip;
    }

    /* Out of the row flow, so the stage's height is the tallest beat and
       nothing else — which is the number the fit rule measures. */
    .project[data-beats] .headline {
      position: absolute; inset: 0; margin: 0;
      display: flex; align-items: center;
    }
    .project[data-beats] .label { grid-row: 1; }
    .project[data-beats] .b2,
    .project[data-beats] .b3 { grid-row: 2; grid-column: 1; }

    .project[data-beats] .label,
    .project[data-beats] .b2,
    .project[data-beats] .b3 { opacity: 0; }

    .project[data-beats] .label {
      display: block;
      font-family: var(--font-mono); font-size: var(--t-sm);
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--paper);
    }

    .project[data-beats] .b2 { padding-bottom: 0; border-bottom: 0; }
    .project[data-beats] .b3 { max-width: 45ch; }
    .project[data-beats] .prose { max-width: none; padding-block: 0; }


    /* --rule is the track, --leader the part of the section already behind
       you: the accent marking current position, which is the one thing it
       is allowed to mean. Nothing fills it unless a pin is driving it. */
    .project[data-beats] .rail {
      display: block; position: absolute;
      left: 0; top: var(--s-8); bottom: var(--s-8); width: 1px;
      background: var(--rule);
    }
    .project[data-beats] .rail > span {
      position: absolute; inset: 0; background: var(--leader);
      transform: scaleY(0); transform-origin: top;
    }
  }
</style>
