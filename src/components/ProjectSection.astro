---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /* 1 on the standalone fallback page, where the project is the document.
     3 on `/`, under the hero h1 and the "Work" h2. */
  level?: 1 | 3;
}
const { project, level = 3 } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const H = `h${level}` as 'h1' | 'h3';

// Split rather than string-replace, so the break is content's decision and
// not a match on whatever words happen to be in the headline.
const words = d.headline.trim().split(/\s+/);
const lines =
  d.headlineBreak === undefined
    ? null
    : [words.slice(0, d.headlineBreak + 1).join(' '), words.slice(d.headlineBreak + 1).join(' ')];
---
{/* §4.3 — three blocks, stacked below 900px and arranged as a pinnable
    stage above it: the headline across the top, then the lead and the
    writeup side by side. The headline is display type at 7vw and does not
    survive being put in a column — full width is the only place it fits,
    which is what sets this layout rather than a plain two-column split. */}
<section
  id={project.id}
  class="wrap project"
  data-path={`/projects/${project.id}`}
  aria-labelledby={`${project.id}-h`}
>
  <header class="head">
    <div class="top">
      <span class="id">{d.machineId}</span>
      <span class="period">{d.period} · {d.role}</span>
    </div>
    <H id={`${project.id}-h`} class="headline">
      {/* The space before the <br> is load-bearing: without it textContent
          reads "Inferencein the browser", and that string is the section's
          accessible name via aria-labelledby. It collapses when rendered. */}
      {lines ? <>{lines[0]}{' '}<br />{lines[1]}</> : d.headline}
    </H>
  </header>

  <div class="lead">
    <p class="summary">{d.summary}</p>

    {d.metrics.length > 0 && (
      <dl class="stats">
        {d.metrics.map((m) => (
          <div><dt>{m.value}</dt><dd>{m.label}</dd></div>
        ))}
      </dl>
    )}

    <p class="links">
      {d.liveUrl && <a href={d.liveUrl}>Live</a>}
      {d.repoUrl && <a href={d.repoUrl}>Source</a>}
      <span class="stack">{d.stack.join(' · ')}</span>
    </p>
  </div>

  {/* Column rule and progress readout in one, filled by projects.ts while
      the section is pinned. Empty is its correct resting state, so with no
      JS — or no pin — it is just the rule. */}
  <div class="rail" aria-hidden="true"><span></span></div>

  <div class="prose"><Content /></div>
</section>

<style>
  .head { padding-block: var(--s-12) 0; }
  .top { display: flex; justify-content: space-between; gap: var(--s-4); align-items: baseline; }
  .id, .period, .stack {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .id { color: var(--leader); }
  .period, .stack { color: var(--dim); }

  .headline {
    font-size: var(--t-2xl); line-height: 0.94;
    letter-spacing: -0.045em; font-weight: 500;
    margin-top: var(--s-3); font-variation-settings: 'wdth' 120;
  }

  .lead { padding-bottom: var(--s-8); border-bottom: 1px solid var(--rule); }
  .summary { margin-top: var(--s-4); max-width: 48ch; color: var(--muted); font-size: var(--t-lg); }

  .stats { display: flex; flex-wrap: wrap; gap: var(--s-8); margin-top: var(--s-8); }
  .stats dt { font-size: var(--t-xl); color: var(--leader); font-weight: 500; letter-spacing: -0.03em; }
  .stats dd {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim);
  }

  .links { display: flex; gap: var(--s-4); align-items: baseline; margin-top: var(--s-8); flex-wrap: wrap; }
  .links a {
    font-family: var(--font-mono); font-size: var(--t-meta);
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--leader);
  }

  /* The only two links inside a project, and on a phone the only way out
     of it. 30x16 is under WCAG 2.2's 24px minimum and they are not inline
     in a sentence, so the exception does not cover them — the box grows,
     the ink stays put. The row centres rather than sitting on the baseline
     because the links are now taller than the stack line beside them. */
  @media (max-width: 640px) {
    .links { align-items: center; }
    .links a { display: inline-flex; align-items: center; min-height: 44px; }
  }

  .prose { max-width: var(--measure); padding-block: var(--s-8); }
  .prose :global(p) { color: var(--muted); margin-bottom: var(--s-4); }

  .rail { display: none; }

  /* The stage. Layout only — it is the same whether or not the section ends
     up pinned, so turning motion off changes nothing about what is on
     screen. projects.ts decides pinning separately, and per section: a
     section taller than the viewport is never pinned, because pinning one
     puts its own last paragraph behind the fold with no way to scroll to
     it. That is also why the height of the stage is a floor, not a cap. */
  @media (min-width: 900px) {
    .project {
      display: grid;
      /* The lead is a summary and four numbers; the writeup is 62ch of
         prose and always the taller of the two. Splitting the difference
         in its favour is what decides whether the pair fits on one
         screen, which is what decides whether the section can be pinned
         at all. */
      grid-template-columns: minmax(0, 0.85fr) 1px minmax(0, 1.15fr);
      column-gap: var(--s-12);
      row-gap: var(--s-8);
      align-content: center;
      min-height: 100svh;
      padding-block: var(--s-8);
    }
    .head { grid-column: 1 / -1; padding-block: 0; }
    .lead { grid-column: 1; padding-bottom: 0; border-bottom: 0; }
    .prose { grid-column: 3; padding-block: 0; }

    /* --rule is the track, --leader the part of the section already behind
       you: the accent marking current position, which is the one thing it
       is allowed to mean. Nothing fills it unless a pin is driving it. */
    .rail { display: block; grid-column: 2; position: relative; background: var(--rule); }
    .rail > span {
      position: absolute; inset: 0; background: var(--leader);
      transform: scaleY(0); transform-origin: top;
    }
  }
</style>
