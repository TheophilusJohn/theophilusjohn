---
/* §2 ambient texture. Decorative by construction: it is set at --dim,
   which §5 reserves for texture that carries nothing not said elsewhere,
   so it is hidden from the accessibility tree outright rather than left
   for a screen reader to read four hundred log lines of. */
interface Props {
  lines: string[];
  direction?: 'left' | 'right';
  /* Selects which --band-phase-N the head script in index.astro wrote.
     Custom properties inherit, so .track picks --phase up from here. */
  index: number;
}
const { lines, direction = 'left', index } = Astro.props;
---
<div
  class="log-band"
  data-drift={direction}
  style={`--phase: var(--band-phase-${index})`}
  aria-hidden="true"
>
  {/* Twice, so the -50% translate in log-band.ts loops without a seam. */}
  <div class="track">
    {[0, 1].map(() => (
      <div class="run">
        {lines.map((line) => <span class="line">{line}</span>)}
      </div>
    ))}
  </div>
</div>

<style>
  /* clip, not hidden, for the reason spelled out on .hero in index.astro:
     hidden would make this a scroll container and put a scrollport in the
     middle of the document for §11's sticky pins to resolve against. */
  .log-band {
    overflow: clip;
    padding-block: var(--s-3);
    user-select: none;
    contain: content;
  }

  /* The start offset, painted on the first frame. GSAP overwrites this with
     an inline transform when it attaches, at the same value, so the handover
     is invisible. Left runs 0 -> -50%, right runs -50% -> 0, matching the
     tween directions in log-band.ts.

     With no JS, --phase never resolves, the calc is invalid at computed-value
     time, and the track sits at 0 — which is the correct static state. */
  .track {
    display: flex;
    width: max-content;
    transform: translateX(calc(var(--phase) * -50%));
  }
  .log-band[data-drift='right'] .track {
    transform: translateX(calc((var(--phase) - 1) * 50%));
  }
  .run { display: flex; gap: var(--s-8); padding-right: var(--s-8); }

  .line {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    color: var(--dim);
    white-space: nowrap;
  }
  .line::after {
    content: '·';
    margin-left: var(--s-8);
    color: var(--rule);
  }
</style>

<script>
  import '../scripts/log-band';
</script>
