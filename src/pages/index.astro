---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectSection from '../components/ProjectSection.astro';
import LogBand from '../components/LogBand.astro';
import { raftTrace } from '../lib/raft-log';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

/* One run of the cluster, sliced across the three bands in page order, so
   scrolling down is also moving forward through the trace. Fixed seed —
   the trace is content, and content should not change on rebuild. */
const trace = raftTrace(0x686d_6e61, 48);

// Declared as data so the head script below can count them. The three are
// placed by hand rather than mapped, because they sit between sections.
const bands = [
  { direction: 'left' as const, lines: trace.slice(0, 16) },
  { direction: 'right' as const, lines: trace.slice(16, 32) },
  { direction: 'left' as const, lines: trace.slice(32, 48) },
];
---
<Base title="Theophilus John — Distributed systems and infrastructure" entry>
  {/* Start offset for the drift, §2. This has to run in `head`, before any
      band element exists: the phase reaches the track through CSS, so it is
      part of the track's first computed style and there is no frame where an
      unseeded position could paint. An inline script placed next to the band
      in the body would still be racing the parser's first paint.

      Clock only — nothing stored, so every load starts somewhere new. The
      period sets how fast the offset varies between loads, not the drift
      speed, which log-band.ts derives from measured width. The i/count term
      spreads the bands so they never load in step. */}
  <script slot="head" is:inline define:vars={{ count: bands.length }}>
    (function () {
      var t = Date.now() / 1000 / 120;
      for (var i = 0; i < count; i++) {
        document.documentElement.style.setProperty(
          '--band-phase-' + i,
          String((t + i / count) % 1),
        );
      }
    })();
  </script>

  {/* §4.1's decision, and it has to be made here — before first paint and
      before the bundle — because the answer is usually no. Only a load that
      is actually going to run the intro holds anything back; every other
      one paints the page out of the HTML, which is the whole of the fix for
      §10's note that the hold moved LCP behind the JS.

      Two ways to answer no: motion is off (the layout's head script has
      already resolved that attribute above), or the intro has run once in
      this session already. The flag is only read here — intro.ts writes it,
      when the sequence really starts.

      Set only by script, so with JS off the attribute never appears and the
      page is simply visible, which is the correct static state. The timeout
      is the safety net for the other direction: the sequence is an
      enhancement, the words are the page, so if the module throws or never
      arrives the hold comes off anyway. 2s rather than something longer
      because this is a ceiling on LCP, not on patience — intro.ts disarms
      it the moment it loads, so nothing but a failed bundle reaches it. */}
  <script slot="head" is:inline>
    (function () {
      var r = document.documentElement;
      if (r.dataset.motion === 'off') return;
      /* Three ways to answer no now, and this is the one §33 adds. A world
         load plays the intro under an opaque curtain — nobody sees it —
         while the hold in front of it puts the hero's paint behind the JS
         bundle, which is the exact cost §12 armed this narrowly to avoid.
         The world falls back to the document if the adapter request fails,
         and that load then has no intro: an enhancement missing, which is
         what the timeout release below already treats it as. */
      if (r.dataset.mode === 'world') return;
      try {
        if (sessionStorage.getItem('tj:intro')) return;
      } catch (e) {}
      r.dataset.intro = 'pending';
      setTimeout(function () {
        if (r.dataset.intro === 'pending') delete r.dataset.intro;
      }, 2000);
    })();
  </script>

  <LogBand index={0} {...bands[0]} />

  <section class="wrap hero" id="top" data-path="/">
    {/* The space before the break is load-bearing. SplitText names the
        heading from its textContent, and <br> contributes nothing to that —
        without the space the accessible name is "TheophilusJohn". */}
    <h1>Theophilus <br />John</h1>
    {/* The inner span is the thing that moves, and .sub is its clip. The
        sub is not display type — it rises as one block rather than line by
        line, which also keeps SplitText off a <p>: ARIA prohibits naming a
        paragraph, so the aria-label SplitText writes to stand in for the
        split spans is the one place it would be dropped on the floor. */}
    <p class="sub"><span>Builds systems that have to agree with each other.</span></p>
  </section>

  <LogBand index={1} {...bands[1]} />

  <section class="work" id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="meta wrap">Work — {String(projects.length).padStart(2, '0')}</h2>
    {projects.map((p) => <ProjectSection project={p} level={3} />)}
  </section>

  <LogBand index={2} {...bands[2]} />

  <section class="wrap about" id="about" data-path="/about" aria-labelledby="about-h">
    <h2 id="about-h" class="meta">About</h2>
    <div class="prose">
      <p>
        I'm a computer science master's student at the University of Houston–Clear Lake, where
        I also administer the lab environment — a mixed Ubuntu and Windows Server estate used
        by students and faculty. Before that I spent three years at Tata Consultancy Services
        as a systems engineer, working on TCS BaNCS, a core banking platform.
      </p>
      <p>
        Most of what I build ends up being about the same problem: getting separate things to
        agree. Raft is that problem stated formally. CRDTs are that problem without a referee.
        Migrating a directory service is that problem with a deadline and real users. Running
        inference in a browser is the one exception, and it's there because I wanted to know
        whether the arithmetic would fit.
      </p>
      <p>
        I'm interested in systems and infrastructure work — the layer where the guarantees are
        made rather than assumed.
      </p>
      {/* The separators are expressions, not literal text at the end of a
          line: Astro strips the newline *and* the space before the next
          tag, so `·` followed by a line break renders as `·<a>` with the
          two words run together. Same bug the footer pair had. */}
      <p class="ends">
        Based in Houston. <a href="/theo-john-resume.pdf">Resume</a>{' · '}
        <a href="https://github.com/TheophilusJohn">GitHub</a>{' · '}
        <a href="mailto:theophilusjohn@gmail.com">theophilusjohn@gmail.com</a>
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/motion';
  import '../scripts/url-sync';
  import '../scripts/intro';
  import '../scripts/hero';
  import '../scripts/projects';
  import '../scripts/cursor';
  import '../scripts/world';
</script>

<style>
  /* The hero word is meant to bleed off the right edge at wdth 125.
     Clip it here so the bleed never reaches the document scrollport.

     clip, not hidden: `hidden` would make .hero a scroll container,
     and `overflow-x: hidden` forces overflow-y to auto — which makes
     it the nearest scrollport for any descendant position: sticky.
     `clip` creates no scroll container, so §11's pinning still
     resolves against the page. Do not "simplify" this to hidden. */
  .hero {
    padding-block: var(--s-12) var(--s-8);
    overflow-x: clip;
  }
  h1 {
    font-size: var(--t-hero); line-height: 0.84;
    letter-spacing: -0.06em; font-weight: 500;
    font-variation-settings: 'wdth' 125;

    /* How far the ink falls past a 0.84 line box, measured off Archivo's
       own metrics rather than guessed: baseline at 0.754em, descender
       0.173em under it, box 0.84em — so 0.087em hangs out the bottom.
       The p in "Theophilus" is the only glyph in the hero that needs it,
       and a clip at the line box would cut it clean off. Rounded up, so
       a fallback face with a deeper descender is not clipped mid-swap.
       (Nothing overflows the top: the caps start 0.031em inside it.) */
    --descender: 0.12em;

    /* Stops the last mask's negative margin from collapsing out through
       the heading and dragging .sub up by 0.12em of hero — which at the
       clamp ceiling is 1.9rem, straight into the second line. */
    display: flow-root;
  }

  /* SplitText builds the lines and their masks at runtime, so neither ever
     carries this component's scope attribute. Reach them from an ancestor
     that does.

     The padding gives the clip enough room for the descender; the matching
     negative margin on the mask takes it back out of the layout, so the
     split heading occupies exactly the height the unsplit one did and the
     reveal costs no shift. The two masks overlap by that much — which is
     already true of the ink at line-height 0.84, and each mask clips only
     its own line. */
  h1 :global(.reveal-line) { padding-bottom: var(--descender); }
  h1 :global(.reveal-line-mask) { margin-bottom: calc(-1 * var(--descender)); }

  .sub {
    margin-top: var(--s-6); max-width: 46ch;
    color: var(--leader); font-size: var(--t-lg); line-height: 1.5;

    /* Clips its span on the axis the reveal travels, and only that axis,
       for the reason on the masks below. No descender allowance needed:
       at line-height 1.5 the half-leading is 0.205em and the deepest ink
       0.173em, so the last line box already contains it. */
    overflow: visible clip;
  }
  .sub > span { display: block; }

  .work > .meta { display: block; padding-block: var(--s-12) 0; }

  .about { padding-block: var(--s-24) var(--s-12); }
  .about > .meta { display: block; margin-bottom: var(--s-4); }
  .about .prose { max-width: var(--measure); color: var(--muted); }
  .about .prose p { margin-bottom: var(--s-4); }

  /* The dot-separated run at the end is a *row of links*, not links inline
     in a sentence, which is the distinction §3 drew when it grew the
     project rows: WCAG 2.2 asks 24px and these are 16 tall, and the
     exception does not cover a row. Same fix as `.links`, at the same
     breakpoint — the box grows, the ink does not move. The separators stay
     outside the anchors so no link is named "· GitHub". */
  @media (max-width: 640px) {
    .about .ends a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
